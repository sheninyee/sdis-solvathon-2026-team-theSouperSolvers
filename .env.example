# Azure OpenAI — required for semantic scoring and AI features
# Without these, app runs in keyword_fallback mode (still functional)
AOAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AOAI_KEY=<your-azure-openai-key>
AOAI_EMBEDDING_MODEL=embed
AOAI_CHAT_MODEL=chat

# Azure Storage — optional; falls back to data/sample/ without it
STORAGE_CONN=DefaultEndpointsProtocol=https;AccountName=...

# Access gate — leave blank for open access, set a passphrase to require login
APP_ACCESS_CODE=
